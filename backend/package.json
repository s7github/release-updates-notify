{
  "name": "@updatenotify/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloud Run services: scraping, AI extraction, and push fan-out.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.1.0",
    "@google/genai": "^1.29.0",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^11.0.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
