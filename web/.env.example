# The authenticated backend API used for discovery, refresh and admin actions.
# Local development (backend on :8080):
# VITE_API_URL=http://localhost:8080
#
# Production (the current Vercel project):
# VITE_API_URL=https://updatenotify-api-vwdnd6mwaq-ez.a.run.app
#
# If omitted, production falls back to that deployed API host and development
# falls back to http://localhost:8080.
#
# There is deliberately no GEMINI_API_KEY here. The browser never calls Gemini;
# the key belongs to the backend only (ADR-0003).
VITE_API_URL=

# Firebase auth handler host. Production uses www.releasescope.com (see firebase-applet-config.json),
# where Vercel proxies /__/auth/*. The dev server has no such proxy, so set this for local runs:
# VITE_AUTH_DOMAIN=gen-lang-client-0099813375.firebaseapp.com
VITE_AUTH_DOMAIN=

# Optional override for the catalog index used by search suggestions.
# Defaults to <VITE_API_URL>/v1/catalog-index.json.
VITE_CATALOG_INDEX_URL=
