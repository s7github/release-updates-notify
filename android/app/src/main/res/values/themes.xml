<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Compose supplies the real theme; this only has to exist and not flash
         white before the first frame. -->
    <style name="Theme.UpdateNotify" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.UpdateNotify.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_notification</item>
        <item name="postSplashScreenTheme">@style/Theme.UpdateNotify</item>
    </style>

</resources>
