{
  "//": "Firestore runs without these until a collection grows, then fails. Declared rather than discovered in production. See docs/DATA_MODEL.md section 10.",
  "indexes": [
    {
      "//": "Library list: a person's follows, newest first.",
      "collectionGroup": "interests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Version timeline for one software item.",
      "collectionGroup": "release_notes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "softwareId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "releaseDate",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Incremental client sync against the stored watermark.",
      "collectionGroup": "release_notes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "softwareId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "A person watching their own enqueued pipeline jobs.",
      "collectionGroup": "background_tasks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "requestedBy",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Scheduler picking which catalog entries are due for a poll.",
      "collectionGroup": "master_registry",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "active",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "lastCheck",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "History-scrape progress for one product.",
      "collectionGroup": "background_tasks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "softwareId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Reaper: tasks that stopped making progress (status in pending/processing, oldest update first).",
      "collectionGroup": "background_tasks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "//": "searchTokens is only ever queried with array-contains; skip the other index modes.",
      "collectionGroup": "master_registry",
      "fieldPath": "searchTokens",
      "indexes": [
        {
          "queryScope": "COLLECTION",
          "arrayConfig": "CONTAINS"
        }
      ]
    },
    {
      "//": "Never queried; a long indexed string costs write and storage for nothing.",
      "collectionGroup": "release_notes",
      "fieldPath": "rawData",
      "indexes": []
    },
    {
      "collectionGroup": "release_notes",
      "fieldPath": "summary",
      "indexes": []
    },
    {
      "//": "Audit before/after snapshots are maps; never queried.",
      "collectionGroup": "admin_audit",
      "fieldPath": "before",
      "indexes": []
    },
    {
      "collectionGroup": "admin_audit",
      "fieldPath": "after",
      "indexes": []
    },
    {
      "//": "Progress details are a map; never queried.",
      "collectionGroup": "background_tasks",
      "fieldPath": "details",
      "indexes": []
    },
    {
      "//": "TTL fields. Deletion by TTL needs the policy, not an index.",
      "collectionGroup": "background_tasks",
      "fieldPath": "expiresAt",
      "indexes": []
    },
    {
      "collectionGroup": "system_learnings",
      "fieldPath": "expiresAt",
      "indexes": []
    },
    {
      "collectionGroup": "admin_audit",
      "fieldPath": "expiresAt",
      "indexes": []
    }
  ]
}
