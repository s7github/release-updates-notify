{
  "name": "@updatenotify/firebase",
  "private": true,
  "version": "0.1.0",
  "description": "Firestore security rules, indexes, and their tests.",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project updatenotify-test \"node --test test/*.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "emulators": "firebase emulators:start"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^14.0.0",
    "firebase": "^12.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
